# The versions of the tools that CI, releases and the scripts use, in one
# place (quality review G2). Every workflow job that needs one reads this
# file into its environment first; scripts/build-release.sh,
# scripts/verify-release.sh and scripts/help-deploy.sh read it too. Lines
# are NAME=value, without quotes or spaces; a downloaded binary has its
# SHA-256 beside it. Dependabot (.github/dependabot.yml) can't see this
# file, so update it by hand.
#
# Not here: the actions, pinned by commit in the workflows, and Go's
# modules, in go.mod (Dependabot keeps both up to date), and the Debian
# image, pinned by digest in release.yml and apt-publish.yml, where a job's
# container has to name it before any step can read a file.

# The Go that CI and releases build with. go.mod names only the oldest Go
# Roostack supports (1.26); this is the one Cloud pins, the first with
# fixes for the standard library's published vulnerabilities (Cloud's
# docs/REVIEW-2026-10-16.md), so govulncheck's findings are about it.
# scripts/build-release.sh makes the go tool fetch it if the builder has
# another.
GO_VERSION=1.27.3

GOVULNCHECK_VERSION=v1.9.0
ACTIONLINT_VERSION=v1.7.12
# 2026.2.2; staticcheck.conf has its settings.
STATICCHECK_VERSION=v0.8.2

# From the release's linux.x86_64 archive on GitHub.
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# Debian 13's restic (docs/ASSUMPTIONS.md L9), from restic's release,
# checked against the SHA-256 in its SHA256SUMS.
RESTIC_VERSION=0.18.0
RESTIC_SHA256=98f6dd8bf5b59058d04bfd8dab58e196cc2a680666ccee90275a3b722374438e

# uv, which builds the help site with the Zensical in help/uv.lock, from
# uv's release, checked against the SHA-256 in its .sha256 file. The
# aarch64 one is for rebuilding a release on an ARM machine
# (scripts/verify-release.sh).
UV_VERSION=0.12.22
UV_SHA256=b9980552309f09c15172b8be828555e375097f16deb459795ce7bfd200380f0b
UV_SHA256_AARCH64=6f66a14e8239871fb477f9746c941fedfa77e8fe28a8bc7c07e1dc7f53a66712

# Cloudflare's Wrangler, which scripts/help-deploy.sh publishes the help
# site with (npx fetches it).
WRANGLER_VERSION=4.143.0
