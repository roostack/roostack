// The public help (SPEC.md §6.3.1): the Zensical build in site/, served as
// Cloudflare static assets, like the website (roostack.cloud, in Roostack
// Cloud's repository). Deploy with scripts/help-deploy.sh, which builds the
// site and writes its headers:
//
// - Without --env: the preview, roostack-help-preview on workers.dev, not indexed.
// - --env production (scripts/help-deploy.sh --production): help.roostack.cloud.
//   Prepared, not yet published (2026-10-14); Roostack Cloud's ops/site-deploy.sh
//   publishes it with an API token, never a personal login.
//
// Until launch a small Worker (worker/index.js) runs first for every
// address (worker/gate.js): the preview keeps the password (GATE
// "password", and the secret SITE_PASSWORD, which ops/site-deploy.sh sets
// from sops); help.roostack.cloud is open but marked not to be indexed
// (GATE "noindex", the Owner, 2026-10-23). At launch: GATE "off" (and the
// Worker can go).
{
  "name": "roostack-help-preview",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "main": "worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "vars": { "GATE": "password" },

  "env": {
    "production": {
      "name": "roostack-help",
      "workers_dev": false,
      "routes": [{ "pattern": "help.roostack.cloud", "custom_domain": true }],
      "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
      "vars": { "GATE": "noindex" }
    }
  }
}
