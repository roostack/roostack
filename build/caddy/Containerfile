# MyLab's Caddy image: upstream Caddy plus DNS provider plugins for the
# DNS-01 challenge (SPEC.md §6.5). Keep in sync with internal/dns (a test
# checks every provider's plugin is listed here).
#
# Build: podman build -t mylab-caddy build/caddy
# TODO: pin base images by digest and publish to a registry.
FROM docker.io/library/caddy:2-builder AS builder
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare \
    --with github.com/caddy-dns/route53 \
    --with github.com/caddy-dns/porkbun \
    --with github.com/caddy-dns/gandi \
    --with github.com/caddy-dns/godaddy \
    --with github.com/caddy-dns/namecheap \
    --with github.com/caddy-dns/spaceship

FROM docker.io/library/caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
