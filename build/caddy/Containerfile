# Roostack's Caddy image: upstream Caddy plus DNS provider plugins for the
# DNS-01 challenge (SPEC.md §6.5), CrowdSec's bouncer (with its AppSec
# handler, the web application firewall) and rate limiting for public
# addresses (SPEC.md §6.10, §6.11), and the layer-4 plugin, which
# passes connections through an edge by name (SPEC.md §10.5). Keep in sync with internal/dns (a test
# checks every provider's plugin is listed here, at a fixed version).
#
# Everything is pinned (SPEC.md §8.1): the base images by tag and digest
# (the multi-arch index, so it works on ARM too), and each plugin by
# version; Go's checksum database then fixes the rest of the build. To
# update, change the versions here, build, and check a certificate is
# issued on a VM; then publish the image and name it in
# internal/generate/caddyimage.go (docs/RELEASING.md).
#
# Servers download this image, built by Roostack's Caddy image workflow
# (scripts/build-caddy-image.sh), rather than build it (SPEC.md §6.5). This
# file is here, and on each server, so that anyone can read and rebuild
# what's in it. The builder runs on the build machine's own processor
# ($BUILDPLATFORM) and compiles for the image's ($TARGETARCH), so one
# machine builds both without emulation; the last stage only copies.
#
# Build: podman build -t roostack-caddy build/caddy
# Both processors: podman build --platform linux/amd64,linux/arm64 --manifest roostack-caddy build/caddy
FROM --platform=$BUILDPLATFORM docker.io/library/caddy:2.11.9-builder@sha256:cda07fe9d82728c7ac44d844306d435e98131423dc7b114f05a8a8ecfff94707 AS builder
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH xcaddy build \
    --with github.com/caddy-dns/cloudflare@v0.2.4 \
    --with github.com/caddy-dns/route53@v1.6.2 \
    --with github.com/caddy-dns/porkbun@v0.3.1 \
    --with github.com/caddy-dns/gandi@v1.1.0 \
    --with github.com/caddy-dns/godaddy@v1.2.0 \
    --with github.com/caddy-dns/namecheap@v1.0.0 \
    --with github.com/caddy-dns/spaceship@v1.0.0 \
    --with github.com/caddy-dns/acmedns@v0.7.0 \
    --with github.com/hslatman/caddy-crowdsec-bouncer/http@v0.14.1 \
    --with github.com/hslatman/caddy-crowdsec-bouncer/appsec@v0.14.1 \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --with github.com/mholt/caddy-l4@v0.1.2

FROM docker.io/library/caddy:2.11.9@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
