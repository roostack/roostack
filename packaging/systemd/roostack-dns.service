[Unit]
Description=Roostack's DNS server for home and VPN devices
Documentation=file:///usr/share/doc/roostack/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
User=roostack
Group=roostack
ExecStart=/usr/bin/roostack dns
# It exits by itself when the names file goes (roostack-dns.path starts it
# again when it's back); anything else, it starts again.
Restart=on-failure
RestartSec=2
# Where Roostack's daemon asks it for the check on Your account.
RuntimeDirectory=roostack-dns
RuntimeDirectoryMode=0750
# The home addresses that asked, for the count of devices.
StateDirectory=roostack-dns
StateDirectoryMode=0700

# Sandboxing: it parses packets from any device at home, so it sees none of
# Roostack's state or secrets, only the names file (SPEC.md §6.5.3).
ProtectSystem=strict
TemporaryFileSystem=/var/lib/roostack:ro
BindReadOnlyPaths=/var/lib/roostack/dns
InaccessiblePaths=/srv/roostack
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=128M
