[Unit]
Description=Roostack agent (privileged helper)
Documentation=file:///usr/share/doc/roostack/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/roostack-agent
Restart=on-failure
# The agent needs root for sysctl and nftables, but nothing in /home.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
