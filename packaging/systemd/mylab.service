[Unit]
Description=MyLab management service
Documentation=file:///usr/share/doc/mylab/ARCHITECTURE.md
After=network-online.target mylab-agent.service user@@MYLAB_UID@.service
Wants=network-online.target mylab-agent.service
Requires=user@@MYLAB_UID@.service

[Service]
User=mylab
Group=mylab
# @MYLAB_UID@ is replaced by the installer: systemd specifiers can't give
# the UID of User= in a system unit.
Environment=XDG_RUNTIME_DIR=/run/user/@MYLAB_UID@
ExecStart=/usr/local/bin/mylab serve
Restart=on-failure

# Sandboxing (SPEC.md §6.1).
ProtectSystem=strict
ReadWritePaths=/var/lib/mylab /srv/mylab /run/user/@MYLAB_UID@
# ProtectHome=yes would also hide /run/user, where the mylab user's systemd
# manager listens. Hide /home and /root, and bind back only mylab's own
# runtime directory.
ProtectHome=tmpfs
BindPaths=/run/user/@MYLAB_UID@
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# mylab never runs podman itself; it goes through the user manager with
# systemd-run --user, so this sandbox doesn't break rootless podman's setuid
# helpers (SPEC.md §6.1).
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
