[Unit]
Description=MyLab management service
Documentation=file:///usr/share/doc/mylab/ARCHITECTURE.md
After=network-online.target mylab-agent.service
Wants=network-online.target mylab-agent.service
# The mylab user's runtime directory (its UID) comes from a drop-in the
# package writes: mylab.service.d/user.conf.

[Service]
User=mylab
Group=mylab
ExecStart=/usr/bin/mylab serve
# Always: MyLab restarts itself to apply settings from the setup wizard.
Restart=always
RestartSec=1

# Sandboxing (SPEC.md §6.1).
ProtectSystem=strict
ReadWritePaths=/var/lib/mylab /srv/mylab
# ProtectHome=yes would also hide /run/user, where the mylab user's systemd
# manager listens. Hide /home and /root, and bind back only mylab's own
# runtime directory (in the drop-in).
ProtectHome=tmpfs
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# mylab never runs podman itself; it goes through the user manager with
# systemd-run --user, so this sandbox doesn't break rootless podman's setuid
# helpers (SPEC.md §6.1).
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
