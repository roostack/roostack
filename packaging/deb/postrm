#!/bin/sh
# Removing Roostack never deletes the lab: services' data, backups settings and
# the recovery key stay in /var/lib/roostack and /srv/roostack.
set -e
if [ "$1" = purge ]; then
    rm -rf /etc/systemd/system/roostack.service.d
    systemctl daemon-reload || true
    echo "Roostack's data is kept in /var/lib/roostack and /srv/roostack; delete them yourself if you're sure." >&2
fi
exit 0
