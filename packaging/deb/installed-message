#!/bin/sh
# Shows how to open Roostack's setup page, with the setup code, at the end
# of a fresh install (called from postinst). Run it again any time:
#   sudo /usr/share/roostack/installed-message
#
# The setup code is also in Roostack's log (docs/ASSUMPTIONS.md K5); it only
# works until the Owner's account exists.

TOKEN=/var/lib/roostack/setup-token
PORT=8480

# Roostack writes the code when it first starts (postinst has just started
# it), so give it a moment.
i=0
while [ ! -s "$TOKEN" ] && [ $i -lt 30 ] && systemctl is-active --quiet roostack.service; do
    sleep 1
    i=$((i + 1))
done
code=$(cat "$TOKEN" 2>/dev/null)

# Colour only on a terminal, and never when NO_COLOR is set (no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    bold=$(printf '\033[1m') bird=$(printf '\033[1;33m') stack=$(printf '\033[36m')
    green=$(printf '\033[1;32m') code_on=$(printf '\033[1;30;43m') off=$(printf '\033[0m')
else
    bold='' bird='' stack='' green='' code_on='' off=''
fi

# Where to reach this server from another computer: its first address, and
# the user who ran sudo (or root).
addr=$(hostname -I 2>/dev/null | awk '{print $1}')
who=${SUDO_USER:-root}

cat <<MSG

${bird}       __
     <(o )___${off}      ${green}Roostack is installed${off}
${bird}      ( ._> /${off}
${bird}       \`---'${off}
${stack}    ===========
    ===========${off}

MSG

if [ -n "$code" ]; then
    cat <<MSG
Open the setup page to create your lab, or restore one from its backups.

  ${bold}Setup code:${off}  ${code_on} $code ${off}

MSG
elif ! systemctl is-active --quiet roostack.service; then
    cat <<MSG
Roostack didn't start, so there's no setup code yet. See what happened:
    sudo journalctl -u roostack

MSG
    exit 0
else
    cat <<MSG
This server already has an Owner (or was restored from backups): log in
with that account.

MSG
fi

cat <<MSG
The setup page is only reachable on this server: ${bold}http://127.0.0.1:$PORT${off}
From another computer, forward it over SSH, then open that address there:
    ${bold}ssh -L $PORT:127.0.0.1:$PORT $who@${addr:-<this server>}${off}

MSG
exit 0
