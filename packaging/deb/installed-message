#!/bin/sh
# Shows how to open Roostack's setup page, with the setup code, at the end
# of a fresh install (called from postinst). Run it again any time:
#   sudo /usr/share/roostack/installed-message
#
# The setup code is also in Roostack's log (docs/ASSUMPTIONS.md K5); it only
# works until the Owner's account exists.

TOKEN=/var/lib/roostack/setup-token
CERT=/var/lib/roostack/setup-tls.crt
PORT=8480
SETUP_PORT=8443

# Roostack writes the code and the setup pages' certificate when it first
# starts (postinst has just started it), so give it a moment.
i=0
while { [ ! -s "$TOKEN" ] || [ ! -s "$CERT" ]; } && [ $i -lt 30 ] && systemctl is-active --quiet roostack.service; do
    sleep 1
    i=$((i + 1))
done
# Read as the roostack user, whose folder it is: as root, a symlink put
# there would be followed. Only the characters a code has are kept, so
# nothing else reaches the terminal (SPEC.md §6.1).
asroostack() { setpriv --reuid=roostack --regid=roostack --clear-groups "$@" 2>/dev/null; }
code=$(asroostack cat "$TOKEN" | tr -cd 'A-Za-z0-9_-' | cut -c1-64)
# The certificate's SHA-256 fingerprint, as browsers show it (AB:CD:…), in
# two halves to fit the terminal (SPEC.md §6.3.2).
pem=$(asroostack cat "$CERT" | sed '/-----/d')
fp=
if [ -n "$pem" ]; then
    fp=$(echo "$pem" | base64 -d | sha256sum | cut -c1-64 | tr 'a-f' 'A-F' | sed 's/../&:/g; s/:$//')
fi
fp1=$(echo "$fp" | cut -c1-48) fp2=$(echo "$fp" | cut -c49-)

# Colour only on a terminal, and never when NO_COLOR is set (no-color.org).
# apt runs dpkg, and so this, in a terminal of its own (a pseudo-terminal)
# even when apt's output goes to a file or a pipe, so [ -t 1 ] holds there:
# under apt, what counts is where apt's own output goes.
on_terminal() {
    [ -t 1 ] || return 1
    pid=$PPID
    while [ "${pid:-0}" -gt 1 ]; do
        case $(cat "/proc/$pid/comm" 2>/dev/null) in
        apt | apt-get | aptitude | unattended-upgr*)
            case $(readlink "/proc/$pid/fd/1" 2>/dev/null) in
            /dev/pts/* | /dev/tty*) return 0 ;;
            *) return 1 ;;
            esac
            ;;
        esac
        pid=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
    done
    return 0
}
if on_terminal && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    bold=$(printf '\033[1m') bird=$(printf '\033[1;33m') stack=$(printf '\033[36m')
    green=$(printf '\033[1;32m') code_on=$(printf '\033[1;30;43m') link=$(printf '\033[1;36m')
    off=$(printf '\033[0m')
else
    bold='' bird='' stack='' green='' code_on='' link='' off=''
fi

# Where to reach this server from another computer: the address it reaches
# the internet from, and the user who ran sudo (or root).
addr=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
[ -n "$addr" ] || addr=$(hostname -I 2>/dev/null | awk '{print $1}')
who=${SUDO_USER:-root}
# The setup pages are served to the home network only: an address in a
# private range (a cloud server's public one gets the SSH tunnel).
home=
case "$addr" in
10.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) [ -s "$CERT" ] && [ -n "$fp" ] && home=$addr ;;
esac

cat <<MSG

${bird}       __
     <(o )___${off}      ${green}Roostack is installed${off}
${bird}      ( ._> /${off}
${bird}       \`---'${off}
${stack}    ===========
    ===========${off}

MSG

if ! systemctl is-active --quiet roostack.service; then
    cat <<MSG
Roostack didn't start, so there's no setup page yet. See what happened:
    sudo journalctl -u roostack

MSG
    exit 0
fi

if [ -n "$code" ] && [ -n "$home" ]; then
    cat <<MSG
${bold}Adding this server to a lab you already have?${off} Don't use the setup page:
on your lab, go to Settings > Servers > Add a server, and run the command
it gives you on this server.

${bold}To set up a new lab${off}, open the setup page on a computer or phone on the
same network as this server:

    ${link}https://$home:$SETUP_PORT${off}

Your browser warns that the connection isn't private: the page has its own
certificate, made by this server. Check it's this one (the warning's
details, or the padlock), then go on. Its SHA-256 fingerprint is:

    $fp1
    $fp2

Then enter the setup code:  ${code_on} $code ${off}

Or through SSH instead: from your computer, run this in a terminal, leave
it open, and open ${link}http://127.0.0.1:$PORT${off}

    ${link}ssh -L $PORT:127.0.0.1:$PORT $who@$home${off}

MSG
elif [ -n "$code" ]; then
    cat <<MSG
${bold}Adding this server to a lab you already have?${off} Don't use the setup page:
on your lab, go to Settings > Servers > Add a server, and run the command
it gives you on this server.

${bold}To set up a new lab${off}, open the setup page. It's only reachable on this
server, so from your computer (Windows, macOS or Linux), run this in a
terminal and leave it open:

    ${link}ssh -L $PORT:127.0.0.1:$PORT $who@${addr:-<this server>}${off}

Then open ${link}http://127.0.0.1:$PORT${off} in your browser, and enter the setup
code:  ${code_on} $code ${off}

MSG
else
    cat <<MSG
This server already has an Owner (or was restored from backups): log in
with that account. From your computer, run this in a terminal and leave it
open:

    ${link}ssh -L $PORT:127.0.0.1:$PORT $who@${addr:-<this server>}${off}

Then open ${link}http://127.0.0.1:$PORT${off} in your browser.

MSG
fi
exit 0
