#!/bin/sh
# Shows how to open Roostack's setup page, with the setup code, at the end
# of a fresh install (called from postinst). Run it again any time:
#   sudo /usr/share/roostack/installed-message
#
# The setup code is also in Roostack's log (docs/ASSUMPTIONS.md K5); it only
# works until the Owner's account exists.

TOKEN=/var/lib/roostack/setup-token
PORT=8480

# Roostack writes the code when it first starts (postinst has just started
# it), so give it a moment.
i=0
while [ ! -s "$TOKEN" ] && [ $i -lt 30 ] && systemctl is-active --quiet roostack.service; do
    sleep 1
    i=$((i + 1))
done
code=$(cat "$TOKEN" 2>/dev/null)

# Colour only on a terminal, and never when NO_COLOR is set (no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    bold=$(printf '\033[1m') bird=$(printf '\033[1;33m') stack=$(printf '\033[36m')
    green=$(printf '\033[1;32m') code_on=$(printf '\033[1;30;43m') link=$(printf '\033[1;36m')
    off=$(printf '\033[0m')
else
    bold='' bird='' stack='' green='' code_on='' link='' off=''
fi

# Where to reach this server from another computer: the address it reaches
# the internet from, and the user who ran sudo (or root).
addr=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
[ -n "$addr" ] || addr=$(hostname -I 2>/dev/null | awk '{print $1}')
who=${SUDO_USER:-root}

cat <<MSG

${bird}       __
     <(o )___${off}      ${green}Roostack is installed${off}
${bird}      ( ._> /${off}
${bird}       \`---'${off}
${stack}    ===========
    ===========${off}

MSG

if ! systemctl is-active --quiet roostack.service; then
    cat <<MSG
Roostack didn't start, so there's no setup page yet. See what happened:
    sudo journalctl -u roostack

MSG
    exit 0
fi

if [ -n "$code" ]; then
    cat <<MSG
${bold}Adding this server to a lab you already have?${off} Don't use the setup page:
on your lab, go to Settings > Servers > Add a server, and run the command
it gives you on this server.

${bold}To set up a new lab${off}, open the setup page. It's only reachable on this
server, so from your computer (Windows, macOS or Linux), run this in a
terminal and leave it open:

    ${link}ssh -L $PORT:127.0.0.1:$PORT $who@${addr:-<this server>}${off}

Then open ${link}http://127.0.0.1:$PORT${off} in your browser, and enter the setup
code:  ${code_on} $code ${off}

MSG
else
    cat <<MSG
This server already has an Owner (or was restored from backups): log in
with that account. From your computer, run this in a terminal and leave it
open:

    ${link}ssh -L $PORT:127.0.0.1:$PORT $who@${addr:-<this server>}${off}

Then open ${link}http://127.0.0.1:$PORT${off} in your browser.

MSG
fi
exit 0
