#!/bin/sh
# Sets up the roostack user and its services (SPEC.md §6.1). Safe to run
# again: dpkg-reconfigure roostack repeats it.
set -e

# The "Roostack is installed" message comes from a trigger on this package,
# which dpkg runs after the other packages' own post-install work (man-db,
# systemd, ...) so the setup code isn't lost in the scroll.
if [ "$1" = triggered ]; then
    if [ -e /run/roostack-installed ]; then
        rm -f /run/roostack-installed
        /usr/share/roostack/installed-message
    fi
    exit 0
fi
[ "$1" = configure ] || exit 0

if ! id roostack >/dev/null 2>&1; then
    useradd --system --create-home --home-dir /var/lib/roostack/home --shell /usr/sbin/nologin roostack
fi
# System users get no subordinate IDs by default; rootless podman needs them
# (docs/ASSUMPTIONS.md B1).
if ! grep -q '^roostack:' /etc/subuid; then
    usermod --add-subuids 200000-265535 --add-subgids 200000-265535 roostack
fi
# GPU access for rootless containers (docs/ASSUMPTIONS.md A7).
for g in render video; do
    if getent group "$g" >/dev/null; then usermod -aG "$g" roostack; fi
done
# Start the roostack user's systemd manager at boot (docs/ASSUMPTIONS.md A1).
loginctl enable-linger roostack
uid=$(id -u roostack)

install -d -o roostack -g roostack -m 0750 /var/lib/roostack /srv/roostack
# What's inside those belongs to the roostack user, which could put a
# symlink there: install -d would follow it and give its target to
# roostack. So these are only made when nothing is there yet (mkdir fails
# on a symlink too), and chown -h never follows one (SPEC.md §6.1,
# docs/ASSUMPTIONS.md S2).
for d in /var/lib/roostack/services /srv/roostack/services /srv/roostack/media; do
    if mkdir -m 0750 "$d" 2>/dev/null; then
        chown -h roostack:roostack "$d"
    fi
done
if [ ! -e /var/lib/roostack/lab.yaml ] && [ ! -L /var/lib/roostack/lab.yaml ]; then
    install -o roostack -g roostack -m 0640 /usr/share/roostack/lab.yaml /var/lib/roostack/lab.yaml
fi
# The agent's own files (its sandbox lets it write here, SPEC.md §6.1).
install -d -m 0755 /etc/roostack

# systemd specifiers can't give the UID of User= in a system unit, so the
# parts that need it go in a drop-in.
install -d /etc/systemd/system/roostack.service.d
cat > /etc/systemd/system/roostack.service.d/user.conf <<CONF
# Written by the roostack package: the roostack user's UID is $uid.
[Unit]
After=user@$uid.service
Requires=user@$uid.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/$uid
ReadWritePaths=/run/user/$uid
BindPaths=/run/user/$uid
CONF

systemctl daemon-reload
systemctl enable roostack-agent.service roostack.service >/dev/null
systemctl restart roostack-agent.service
systemctl restart roostack.service

# A fresh install: show how to open the setup page once dpkg is done.
if [ -z "$2" ]; then
    touch /run/roostack-installed
    dpkg-trigger --no-await roostack-installed || /usr/share/roostack/installed-message
fi
exit 0
