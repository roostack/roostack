# The indentation and quotes Roostack's files use, for editors that read
# this (https://editorconfig.org). There's no formatter for anything but
# Go yet (gofmt), so this records what's in use rather than enforcing it.
root = true

[*]
charset = utf-8
end_of_line = lf

# Go, as gofmt writes it; Makefiles need tabs.
[{*.go,Makefile}]
indent_style = tab

# The package editor's JavaScript (internal/editor), the web UI's scripts,
# styles and templates, and YAML: two spaces, and double quotes in
# JavaScript.
[*.{js,css,html,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.js]
quote_type = double

# Generated by Go's json.MarshalIndent with one space: don't edit.
[internal/editor/static/{schema,examples}.js]
indent_size = 1

# Shell scripts and Python: four spaces.
[*.{sh,py}]
indent_style = space
indent_size = 4
